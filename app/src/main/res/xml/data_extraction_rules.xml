<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Cloud-Backups: Session-Cookies und gecrawlte (ggf. vertrauliche) Inhalte bleiben auf dem Gerät. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
